   ],
   "source": [
    "info = {\n",
    "    \"Name\" : [\"Rahul\", \"Ram\", \"Rakul\"],\n",
    "    \"CGPA\" : [9.5, 9.7, 9.4]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(info)\n",
    "print(df)   # will form a table"
   ]
